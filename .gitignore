__pycache__/
*.pyc
.venv/
venv/
# Never commit a real authorization file or reports containing findings.
# Anchored to the repo root so source folders named "reports" (components/reports) stay tracked.
authorization.yaml
/reports/
*.report.json
*.report.txt

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel
npm-debug.log*

# Local environment files — never commit secrets or API keys
.env
.env*.local

# LinkedIn working files: the repository is public. Voice samples, career
# stories, analytics exports and the post log stay local unless the owner
# asks to commit them (git add -f).
/marketing/linkedin/private/*
!/marketing/linkedin/private/README.md
