# =============================================================================
#  NEXORA — environment variables
# =============================================================================
#  Copy this file to `.env.local` and fill in values from your Supabase project
#  (Supabase Dashboard → Project Settings → API). `.env.local` is git-ignored.
#
#  Until these are set, NEXORA runs in DEMO MODE and shows the sample data in
#  src/lib/demo-data.ts. As soon as both public values below are present, the
#  data layer reads from your Supabase database instead.
# =============================================================================

# Public — safe to expose to the browser (anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only — NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only for trusted server-side admin tasks (e.g. seeding). Optional.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
