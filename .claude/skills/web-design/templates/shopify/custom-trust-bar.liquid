{%- comment -%}
  Trust bar: short reassurance items (delivery, cash on delivery, returns, support).
  Works on any Online Store 2.0 theme. RTL-safe (logical properties only).
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .trust-bar {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding-block: {{ section.settings.padding }}px;
  }
  #shopify-section-{{ section.id }} .trust-bar__grid {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .trust-bar__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  #shopify-section-{{ section.id }} .trust-bar__icon {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(from currentColor r g b / 0.08);
    font-size: 1.25rem;
  }
  #shopify-section-{{ section.id }} .trust-bar__icon img { width: 24px; height: 24px; object-fit: contain; }
  #shopify-section-{{ section.id }} .trust-bar__title { font-weight: 600; margin: 0; line-height: 1.3; }
  #shopify-section-{{ section.id }} .trust-bar__text { margin: 0; font-size: 0.875em; opacity: 0.75; line-height: 1.4; }
{%- endstyle -%}

<div class="trust-bar">
  <div class="trust-bar__grid">
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__icon" aria-hidden="true">
          {%- if block.settings.icon_image != blank -%}
            {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ block.settings.icon_emoji }}
          {%- endif -%}
        </span>
        <div>
          <p class="trust-bar__title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}
            <p class="trust-bar__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F6F7F9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14171F" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 8, "max": 64, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "icon_emoji", "label": "Icon (emoji)", "default": "🚚" },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (overrides emoji)" },
        { "type": "text", "id": "title", "label": "Title", "default": "توصيل سريع" },
        { "type": "text", "id": "text", "label": "Text", "default": "لكل الولايات خلال 2–5 أيام" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon_emoji": "🚚", "title": "توصيل سريع", "text": "لكل الولايات خلال 2–5 أيام" } },
        { "type": "item", "settings": { "icon_emoji": "💵", "title": "الدفع عند الاستلام", "text": "ادفع عندما تستلم طلبك" } },
        { "type": "item", "settings": { "icon_emoji": "↩️", "title": "إرجاع سهل", "text": "خلال 7 أيام من الاستلام" } },
        { "type": "item", "settings": { "icon_emoji": "💬", "title": "دعم سريع", "text": "نرد عليك عبر واتساب" } }
      ]
    }
  ]
}
{% endschema %}
