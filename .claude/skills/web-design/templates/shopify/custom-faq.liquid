{%- comment -%}
  FAQ accordion using native <details>, no JavaScript. Emits FAQPage structured data.
  RTL-safe (logical properties only).
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .faq {
    max-width: 760px;
    margin-inline: auto;
    padding: {{ section.settings.padding }}px 1rem;
  }
  #shopify-section-{{ section.id }} .faq__heading { text-align: center; margin: 0 0 2rem; }
  #shopify-section-{{ section.id }} .faq__item { border-block-end: 1px solid rgb(from currentColor r g b / 0.15); }
  #shopify-section-{{ section.id }} .faq__q {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
    font-weight: 600;
    font-size: 1.05em;
    min-height: 44px;
  }
  #shopify-section-{{ section.id }} .faq__q::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .faq__q::after { content: "+"; font-size: 1.4em; line-height: 1; flex: none; }
  #shopify-section-{{ section.id }} .faq__item[open] .faq__q::after { content: "−"; }
  #shopify-section-{{ section.id }} .faq__a { padding-block-end: 1.1rem; opacity: 0.8; line-height: 1.7; }
  #shopify-section-{{ section.id }} .faq__a > :last-child { margin-block-end: 0; }
{%- endstyle -%}

<div class="faq">
  {%- if section.settings.heading != blank -%}
    <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <details class="faq__item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
      <summary class="faq__q">{{ block.settings.question | escape }}</summary>
      <div class="faq__a">{{ block.settings.answer }}</div>
    </details>
  {%- endfor -%}
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "أسئلة شائعة" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 16, "max": 96, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "كم تستغرق مدّة التوصيل؟" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>اكتب هنا الإجابة الحقيقية.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "كم تستغرق مدّة التوصيل؟", "answer": "<p>اكتب مدّة التوصيل الحقيقية والمناطق المغطّاة.</p>" } },
        { "type": "question", "settings": { "question": "هل الدفع عند الاستلام متاح؟", "answer": "<p>اشرح طرق الدفع المتاحة.</p>" } },
        { "type": "question", "settings": { "question": "هل يمكنني إرجاع المنتج؟", "answer": "<p>اشرح سياسة الإرجاع باختصار.</p>" } }
      ]
    }
  ]
}
{% endschema %}
