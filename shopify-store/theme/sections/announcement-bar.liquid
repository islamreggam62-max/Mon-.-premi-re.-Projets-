{%- comment -%}
  Announcement bar — rotating messages, dismissible, RTL-safe.
  Keep messages TRUE. No fake urgency.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<div class="ann-bar" data-rotate="{{ section.settings.rotate_seconds }}">
  <div class="ann-bar__inner">
    <ul class="ann-bar__list">
      {%- for block in section.blocks -%}
        <li class="ann-bar__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.dismissible -%}
      <button class="ann-bar__close" type="button" aria-label="Close announcement">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var bar = document.querySelector('.ann-bar');
  if (!bar) return;

  // Respect a previous dismissal for this session only.
  try {
    if (sessionStorage.getItem('annBarClosed') === '1') { bar.remove(); return; }
  } catch (e) { /* private mode — just show the bar */ }

  var close = bar.querySelector('.ann-bar__close');
  if (close) {
    close.addEventListener('click', function () {
      bar.remove();
      try { sessionStorage.setItem('annBarClosed', '1'); } catch (e) {}
    });
  }

  var items = bar.querySelectorAll('.ann-bar__item');
  var secs = parseInt(bar.dataset.rotate, 10) || 0;
  if (items.length < 2 || secs < 1) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var i = 0;
  setInterval(function () {
    items[i].classList.remove('is-active');
    i = (i + 1) % items.length;
    items[i].classList.add('is-active');
  }, secs * 1000);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "range", "id": "rotate_seconds", "label": "Rotate every", "min": 0, "max": 12, "step": 1, "unit": "s", "default": 5,
      "info": "Set to 0 to disable rotation." },
    { "type": "checkbox", "id": "dismissible", "label": "Let customers close it", "default": false }
  ],
  "blocks": [
    { "type": "message", "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery to Saudi Arabia & the UAE" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ] }
  ],
  "presets": [
    { "name": "Announcement Bar",
      "blocks": [
        { "type": "message", "settings": { "text": "🚚 Free delivery to Saudi Arabia & the UAE" } },
        { "type": "message", "settings": { "text": "🔁 30-day returns on every order" } },
        { "type": "message", "settings": { "text": "🔒 Secure encrypted checkout" } }
      ] }
  ]
}
{% endschema %}
