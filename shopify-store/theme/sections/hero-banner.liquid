{%- comment -%}
  Hero Banner — premium, clean, mobile-first.
  Install: upload to theme sections/, then Customize > Add section > "Hero Banner".
{%- endcomment -%}

<div class="hero-banner hero-banner--{{ section.settings.height }}" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  {%- if section.settings.image != blank -%}
    <picture class="hero-banner__media">
      {%- if section.settings.image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w,
                  {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
          sizes="100vw">
      {%- endif -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w,
                {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        fetchpriority="high"
        decoding="async">
    </picture>
  {%- endif -%}

  <div class="hero-banner__inner hero-banner__inner--{{ section.settings.text_align }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero-banner__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="hero-banner__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="hero-banner__actions">
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="hero-banner__btn hero-banner__btn--primary">
          {{ section.settings.cta_text | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_text != blank -%}
        <a href="{{ section.settings.cta2_link | default: '#' }}" class="hero-banner__btn hero-banner__btn--ghost">
          {{ section.settings.cta2_text | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="hero-banner__trust">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (portrait crop)" },
    { "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" }
      ], "default": "medium" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "select", "id": "text_align", "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ], "default": "center" },
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow text", "default": "Free delivery to KSA & UAE" },
    { "type": "text",     "id": "heading",    "label": "Heading", "default": "Smart solutions for everyday problems" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Carefully selected products that solve one real problem — and solve it well." },
    { "type": "text", "id": "cta_text",  "label": "Primary button text", "default": "Shop best sellers" },
    { "type": "url",  "id": "cta_link",  "label": "Primary button link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button text" },
    { "type": "url",  "id": "cta2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    { "type": "trust_item", "name": "Trust item", "limit": 4,
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "30-day returns" } ] }
  ],
  "presets": [
    { "name": "Hero Banner",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "Free shipping" } },
        { "type": "trust_item", "settings": { "text": "30-day returns" } },
        { "type": "trust_item", "settings": { "text": "Secure checkout" } }
      ] }
  ]
}
{% endschema %}
