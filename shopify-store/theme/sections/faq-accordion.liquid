{%- comment -%}
  FAQ accordion. Uses native <details>/<summary> — works with JS disabled,
  keyboard accessible, zero JS weight.
{%- endcomment -%}

<div class="faq-section">
  <div class="faq-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="faq-section__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="faq-section__list">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="faq-item__q">
            <span>{{ block.settings.question | escape }}</span>
            <svg class="faq-item__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="faq-item__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_text != blank -%}
      <p class="faq-section__footer">
        {{ section.settings.footer_text | escape }}
        {%- if section.settings.footer_link != blank -%}
          <a href="{{ section.settings.footer_link }}">{{ section.settings.footer_link_text | escape }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  FAQPage structured data — helps Google show your FAQ as a rich result.
  Only emitted when the section actually has questions.
{%- endcomment -%}
{%- if section.blocks.size > 0 and section.settings.enable_schema -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | strip_html | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question by default", "default": true },
    { "type": "checkbox", "id": "enable_schema", "label": "Add FAQ structured data for Google", "default": true },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "Still have a question?" },
    { "type": "text", "id": "footer_link_text", "label": "Footer link text", "default": "Contact us" },
    { "type": "url", "id": "footer_link", "label": "Footer link" }
  ],
  "blocks": [
    { "type": "faq", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are processed in 1-3 business days and delivered within the window shown on the product page.</p>" }
      ] }
  ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "faq" }, { "type": "faq" }, { "type": "faq" } ] } ]
}
{% endschema %}
