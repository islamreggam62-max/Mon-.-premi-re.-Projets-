{%- comment -%}
  Trust strip — payment/guarantee badges. Keep it honest: only claim what is true.
{%- endcomment -%}

<div class="trust-strip">
  <div class="trust-strip__inner">
    {%- if section.settings.heading != blank -%}
      <p class="trust-strip__heading">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="trust-strip__items">
        {%- for block in section.blocks -%}
          <li class="trust-strip__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 160 }}"
                alt="{{ block.settings.label | escape }}"
                width="80" height="48" loading="lazy" decoding="async">
            {%- else -%}
              <span class="trust-strip__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="trust-strip__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Secure checkout" },
    { "type": "text", "id": "note", "label": "Note below badges", "default": "Your payment is encrypted and processed by a PCI-DSS compliant provider." }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Badge image" },
        { "type": "text", "id": "label", "label": "Label / alt text", "default": "Visa" }
      ] }
  ],
  "presets": [ { "name": "Trust Badges", "blocks": [ { "type": "badge" }, { "type": "badge" }, { "type": "badge" } ] } ]
}
{% endschema %}
