{%- comment -%}
  Benefits / Value props row. 3-4 items. Icons are inline SVG (no extra requests).
{%- endcomment -%}

<div class="benefits-bar">
  <div class="benefits-bar__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="benefits-bar__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="benefits-bar__grid">
      {%- for block in section.blocks -%}
        <li class="benefits-bar__item" {{ block.shopify_attributes }}>
          <span class="benefits-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 9.3-8 10-4.6-.7-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- when 'refresh' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.8 8.8 0 0 1-3.9-.9L3 21l1.9-5a8.4 8.4 0 0 1 3.7-11.3 8.8 8.8 0 0 1 12.4 6.8z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
            {%- endcase -%}
          </span>
          <span class="benefits-bar__title">{{ block.settings.title | escape }}</span>
          {%- if block.settings.text != blank -%}
            <span class="benefits-bar__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Benefits Bar",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "truck",   "label": "Delivery" },
            { "value": "shield",  "label": "Secure" },
            { "value": "refresh", "label": "Returns" },
            { "value": "chat",    "label": "Support" },
            { "value": "check",   "label": "Check" }
          ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free delivery" },
        { "type": "text", "id": "text",  "label": "Description", "default": "On every order to KSA & UAE" }
      ] }
  ],
  "presets": [
    { "name": "Benefits Bar",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck",   "title": "Free delivery",   "text": "On every order to KSA & UAE" } },
        { "type": "benefit", "settings": { "icon": "refresh", "title": "30-day returns",  "text": "Simple, no-argument returns" } },
        { "type": "benefit", "settings": { "icon": "shield",  "title": "Secure checkout", "text": "Encrypted payment processing" } },
        { "type": "benefit", "settings": { "icon": "chat",    "title": "24h support",     "text": "Real people, real answers" } }
      ] }
  ]
}
{% endschema %}
