# ---------- Meta (Facebook / Instagram) ----------
# A string you invent; paste the same value into the Meta app webhook setup.
META_VERIFY_TOKEN=choose-a-long-random-string
# Meta app dashboard -> Settings -> Basic -> App Secret
META_APP_SECRET=
# Page Access Token (Messenger, and Instagram accounts linked to a Page)
FACEBOOK_PAGE_TOKEN=
# Only for Instagram accounts using Instagram Login (no linked Page).
# Leave empty to send Instagram replies with FACEBOOK_PAGE_TOKEN.
INSTAGRAM_TOKEN=
GRAPH_API_VERSION=v21.0
# Set to false only for local testing without an app secret.
VERIFY_SIGNATURE=true

# ---------- Claude ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — "low" keeps chat replies fast.
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=1024

# ---------- Conversation memory ----------
HISTORY_MAX_MESSAGES=20
HISTORY_TTL_SECONDS=86400
