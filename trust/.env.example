# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security: used solely by the analysis pipeline
# to store AI results. Never expose it to the browser or prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server only. Claude API key for contract analysis.
ANTHROPIC_API_KEY=

# Optional. Model used for contract analysis (default: claude-opus-5-5).
# TRUST_ANALYSIS_MODEL=claude-opus-5-5

# Public address of the app, used in confirmation and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
