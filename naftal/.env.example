# ============================================================================
# NAFTAL LEGAL INTELLIGENCE — exemple de variables d'environnement
# ----------------------------------------------------------------------------
# L'application lit ces variables dans l'environnement du processus.
# Elle NE charge PAS automatiquement un fichier .env : exportez les variables
# avant de lancer le serveur, par exemple :
#     export NAFTAL_ADMIN_PASSWORD="VotreMotDePasseFort"
# (sous Windows PowerShell :  $env:NAFTAL_ADMIN_PASSWORD="VotreMotDePasseFort")
# ============================================================================

# --- Repertoire de donnees (base SQLite, fichiers, exports) ---
# NAFTAL_DATA_DIR=/chemin/vers/naftal_data

# --- Base de donnees ---
# Par defaut : SQLite dans NAFTAL_DATA_DIR. Pour PostgreSQL :
# DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@localhost:5432/naftal

# --- Securite / sessions ---
# Cle secrete des sessions. Si absente, une cle est generee et persistee.
# NAFTAL_SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
# Duree de session en secondes (defaut 28800 = 8 h)
# NAFTAL_SESSION_MAX_AGE=28800
# Cookies securises uniquement en HTTPS (mettre 1 derriere un reverse proxy TLS)
# NAFTAL_HTTPS_ONLY=0

# --- Compte administrateur initial (cree au premier demarrage) ---
NAFTAL_ADMIN_EMAIL=admin@naftal.local
# Si NAFTAL_ADMIN_PASSWORD est absent, un mot de passe aleatoire est affiche
# UNE SEULE FOIS dans la console au premier demarrage.
# NAFTAL_ADMIN_PASSWORD=ChangezCeMotDePasse

# --- Televersement ---
# NAFTAL_MAX_UPLOAD_MB=25

# ============================================================================
# COUCHE LLM — DESACTIVEE PAR DEFAUT
# ----------------------------------------------------------------------------
# IMPORTANT (confidentialite) : si vous activez cette couche, le texte des
# contrats analyses est transmis au fournisseur externe configure. Ne l'activez
# que pour des documents dont l'envoi externe est autorise.
# ============================================================================
# NAFTAL_LLM_ENABLED=0
# NAFTAL_LLM_PROVIDER=anthropic          # "anthropic" ou compatible OpenAI
# NAFTAL_LLM_MODEL=
# NAFTAL_LLM_API_KEY=                     # jamais exposee au frontend
# NAFTAL_LLM_BASE_URL=                    # pour un point d'acces compatible
