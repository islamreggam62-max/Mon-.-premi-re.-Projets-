# ============================================================================
# NAFTAL LEGAL INTELLIGENCE — exemple de variables d'environnement
# ----------------------------------------------------------------------------
# L'application lit ces reglages dans un fichier nomme « .env », place dans le
# dossier d'ou vous lancez `python -m naftal` (ou indique par NAFTAL_ENV_FILE).
#   - Copiez ce fichier sous le nom « .env », puis retirez le « # » des lignes a activer.
#   - Mettez les commentaires sur LEUR PROPRE ligne (un commentaire en fin de ligne
#     est ignore s'il est precede d'un espace, mais ne comptez pas dessus).
#   - Une VRAIE variable d'environnement l'emporte toujours sur le fichier.
#   - Seules les cles NAFTAL_* et DATABASE_URL sont lues.
# Pour activer l'IA SANS editer de fichier (cle saisie en mode masque) :
#     python -m naftal --setup-llm        puis, pour verifier :  python -m naftal --check-llm
# Le fichier .env peut contenir une cle d'API : ne le partagez pas, ne l'envoyez pas
# par e-mail ; il est deja exclu de git (.gitignore).
# ============================================================================

# --- Repertoire de donnees (base SQLite, fichiers, exports) ---
# NAFTAL_DATA_DIR=/chemin/vers/naftal_data

# --- Base de donnees ---
# Par defaut : SQLite dans NAFTAL_DATA_DIR. Pour PostgreSQL :
# DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@localhost:5432/naftal

# --- Securite / sessions ---
# Cle secrete des sessions. Si absente, une cle est generee et persistee.
# NAFTAL_SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
# Duree de session en secondes (defaut 28800 = 8 h)
# NAFTAL_SESSION_MAX_AGE=28800
# Cookies securises uniquement en HTTPS (mettre 1 derriere un reverse proxy TLS)
# NAFTAL_HTTPS_ONLY=0

# --- Compte administrateur initial (cree au premier demarrage) ---
NAFTAL_ADMIN_EMAIL=admin@naftal.local
# Si NAFTAL_ADMIN_PASSWORD est absent, un mot de passe aleatoire est affiche
# UNE SEULE FOIS dans la console au premier demarrage.
# NAFTAL_ADMIN_PASSWORD=ChangezCeMotDePasse

# --- Televersement ---
# NAFTAL_MAX_UPLOAD_MB=25

# ============================================================================
# COUCHE LLM — DESACTIVEE PAR DEFAUT
# ----------------------------------------------------------------------------
# Activer cette couche DEBLOQUE le mode IA specialise : analyse approfondie
# (regles -> IA -> auto-verification), correction d'avenant, memorandum,
# reecriture de clause, avec ancrage RAG sur votre corpus.
# IMPORTANT (confidentialite) : une fois activee, le texte des contrats est
# transmis au fournisseur externe configure. Ne l'activez que pour des
# documents dont l'envoi externe est autorise.
# ============================================================================
# NAFTAL_LLM_ENABLED=0
# Fournisseur : « anthropic » ou tout autre = format compatible OpenAI
# NAFTAL_LLM_PROVIDER=anthropic
# Modele (vide = modele Claude recent par defaut ; a confirmer dans votre console)
# NAFTAL_LLM_MODEL=claude-opus-5-5
# Cle d'API : jamais exposee au frontend ni affichee dans l'interface
# NAFTAL_LLM_API_KEY=
# Point d'acces personnalise (optionnel)
# NAFTAL_LLM_BASE_URL=

# ============================================================================
# EMBEDDINGS (recherche semantique) — DESACTIVES PAR DEFAUT
# ----------------------------------------------------------------------------
# Complete la recherche lexicale pour les formulations SANS mot commun avec le
# contrat (ex. « arreter la collaboration sans raison » = resiliation sans motif).
# Interrupteur DISTINCT de NAFTAL_LLM_ENABLED. Endpoint compatible /embeddings
# (OpenAI, Voyage AI, serveur local...). Anthropic ne propose pas de modele
# d'embeddings : le fournisseur est a choisir.
# IMPORTANT (confidentialite) : une fois actives, les passages de TOUS les contrats
# indexes sont envoyes au fournisseur (une fois, puis cache local
# NAFTAL_DATA_DIR/embeddings_cache.sqlite). Pour un corpus qui ne peut pas sortir,
# utilisez un serveur d'embeddings LOCAL via NAFTAL_EMBED_BASE_URL.
# NON VERIFIE sur un fournisseur reel (aucune cle lors du developpement).
# ============================================================================
# NAFTAL_EMBED_ENABLED=0
# NAFTAL_EMBED_MODEL=
# NAFTAL_EMBED_API_KEY=
# NAFTAL_EMBED_BASE_URL=https://api.openai.com/v1
# NAFTAL_EMBED_BATCH_SIZE=64
